Cell[BoxData[
 RowBox[{
  RowBox[{"PlotSpheres", "[", 
   RowBox[{"S_", ",", "N_", ",", "RS_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sur", ",", "step", ",", "points", ",", "pointsf", ",", "sphereAll", ",",
       "result", ",", "p"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sur", "=", 
      RowBox[{"Plot3D", "[", 
       RowBox[{
        RowBox[{"S", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"y", ",", 
          RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
        RowBox[{"PlotStyle", "->", 
         RowBox[{"{", 
          RowBox[{"Yellow", ",", 
           RowBox[{"Opacity", "[", "0.5", "]"}]}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"step", "=", 
      RowBox[{"20", "/", 
       RowBox[{"(", 
        RowBox[{"N", "-", "1"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"p", "[", "i_", "]"}], ":=", 
      RowBox[{
       RowBox[{"-", "10"}], "+", 
       RowBox[{"step", "*", 
        RowBox[{"(", 
         RowBox[{"i", "-", "1"}], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"points", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"p", "[", "i", "]"}], ",", 
          RowBox[{"p", "[", "j", "]"}], ",", 
          RowBox[{
           RowBox[{"S", "[", 
            RowBox[{
             RowBox[{"p", "[", "i", "]"}], ",", 
             RowBox[{"p", "[", "j", "]"}]}], "]"}], "+", "RS"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "N"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "N"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"pointsf", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"points", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sphereAll", "=", 
      RowBox[{"Graphics3D", "[", 
       RowBox[{"{", 
        RowBox[{"Blue", ",", 
         RowBox[{"Sphere", "[", 
          RowBox[{"pointsf", ",", "RS"}], "]"}]}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"result", "=", 
      RowBox[{"Show", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"sphereAll", ",", "sur"}], "}"}], ",", 
        RowBox[{"PlotRange", "->", "Automatic"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "result"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.982274837549139*^9, 3.9822748792781544`*^9}, {
  3.9822749626995277`*^9, 3.982275016422556*^9}, {3.9822751687022343`*^9, 
