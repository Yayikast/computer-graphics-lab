Cell[BoxData[
 RowBox[{
  RowBox[{"plotsT", "[", 
   RowBox[{"s_", ",", "Tex_"}], "]"}], ":=", 
  RowBox[{"ParametricPlot3D", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"s0", "[", 
      RowBox[{"u", ",", "v"}], "]"}], "+", 
     RowBox[{"Traj0", "[", "s", "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"u", ",", "0", ",", 
      RowBox[{"2", "*", "Pi"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"v", ",", "0", ",", 
      RowBox[{"2", "*", "Pi"}]}], "}"}], ",", 
    RowBox[{"PlotStyle", "->", 
     RowBox[{"Texture", "[", "Tex", "]"}]}], ",", 
    RowBox[{"Mesh", "->", "False"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9822730343359966`*^9, 3.9822730579573994`*^9}},
 CellLabel->"In[55]:=",ExpressionUUID->"3c135834-9b3c-b848-b04e-35876888ae98"],

