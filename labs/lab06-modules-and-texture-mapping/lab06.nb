Cell[BoxData[
 RowBox[{
  RowBox[{"Interpxyz", "[", "data_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"px", ",", "py", ",", "pz", ",", "fx", ",", "fy", ",", "fz"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"px", ",", "py", ",", "pz"}], "}"}], "=", 
      RowBox[{"Extractxyz", "[", "data", "]"}]}], ";", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"fx", "=", 
      RowBox[{"Interpolation", "[", 
       RowBox[{"px", ",", 
        RowBox[{"Method", "->", "\"\<Spline\>\""}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fy", "=", 
      RowBox[{"Interpolation", "[", 
       RowBox[{"py", ",", 
        RowBox[{"Method", "->", "\"\<Spline\>\""}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"fz", "=", 
      RowBox[{"Interpolation", "[", 
       RowBox[{"pz", ",", 
        RowBox[{"Method", "->", "\"\<Spline\>\""}]}], "]"}]}], ";", 
     RowBox[{"{", 
      RowBox[{"fx", ",", "fy", ",", "fz"}], "}"}]}]}], "]"}]}]], "Input",
