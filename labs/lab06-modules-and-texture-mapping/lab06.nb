Cell[BoxData[
 RowBox[{
  RowBox[{"Extractxyz", "[", "data_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"dataT", ",", "px", ",", "py", ",", "pz"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dataT", "=", 
      RowBox[{"Transpose", "[", "data", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"px", "=", 
      RowBox[{"dataT", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"py", "=", 
      RowBox[{"dataT", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pz", "=", 
      RowBox[{"dataT", "[", 
       RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"px", ",", "py", ",", "pz"}], "}"}]}]}], 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"output", "=", "x"}], ",", "y", ",", "z"}], "*)"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.91889941140179*^9, 3.9188995302122083`*^9}, {
   3.91889957866014*^9, 3.918899597434822*^9}, {3.918912990267743*^9, 
