Cell[BoxData[
 RowBox[{
  RowBox[{"PlotSpheres1", "[", 
   RowBox[{"S_", ",", "N_", ",", "RS_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"s1", ",", "s2", ",", "data", ",", "res"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"s1", "=", 
      RowBox[{"Plot3D", "[", 
       RowBox[{
        RowBox[{"S", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"y", ",", 
          RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
        RowBox[{"PlotStyle", "->", 
         RowBox[{"{", 
          RowBox[{"Yellow", ",", 
           RowBox[{"Opacity", "[", "0.5", "]"}]}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"data", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"S", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"-", "10"}], ",", "10", ",", 
          RowBox[{"20", "/", 
           RowBox[{"(", 
            RowBox[{"N", "-", "1"}], ")"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"y", ",", 
          RowBox[{"-", "10"}], ",", "10", ",", 
          RowBox[{"20", "/", 
           RowBox[{"(", 
            RowBox[{"N", "-", "1"}], ")"}]}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"s2", "=", 
      RowBox[{"ListPointPlot3D", "[", 
       RowBox[{"data", ",", 
        RowBox[{"PlotStyle", "->", 
         RowBox[{"{", 
          RowBox[{"Blue", ",", 
           RowBox[{"PointSize", "[", "RS", "]"}]}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"res", "=", 
      RowBox[{"Show", "[", 
       RowBox[{"{", 
        RowBox[{"s1", ",", "s2"}], "}"}], "]"}]}], ";", "\[IndentingNewLine]",
      "res"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9822770603686676`*^9, 3.9822771392635746`*^9}},
 CellLabel->
  "In[125]:=",ExpressionUUID->"7912db8f-e206-634a-86ca-8a41add9806d"],

