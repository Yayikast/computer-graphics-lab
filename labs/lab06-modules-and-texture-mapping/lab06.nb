Cell[BoxData[
 RowBox[{
  RowBox[{"GL2", "[", 
   RowBox[{"s1_", ",", "s2_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"L", ",", "L1", ",", "G1", ",", "G2", ",", "GAll", ",", "t"}], 
     "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"L", "[", "t_", "]"}], ":=", 
      RowBox[{
       RowBox[{"s1", "*", 
        RowBox[{"(", 
         RowBox[{"1", "-", "t"}], ")"}]}], "+", 
       RowBox[{"s2", "*", "t"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"L1", "=", 
      RowBox[{"ParametricPlot", "[", 
       RowBox[{
        RowBox[{"L", "[", "t", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", 
          RowBox[{"-", "5"}], ",", "5"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"G1", ":=", 
      RowBox[{"Graphics", "[", 
       RowBox[{"{", 
        RowBox[{"Red", ",", 
         RowBox[{"Point", "[", "s1", "]"}]}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"G2", ":=", 
      RowBox[{"Graphics", "[", 
       RowBox[{"{", 
        RowBox[{"Red", ",", 
         RowBox[{"Point", "[", "s2", "]"}]}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GAll", "=", 
      RowBox[{"Show", "[", 
       RowBox[{"{", 
        RowBox[{"L1", ",", "G1", ",", "G2"}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "GAll"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9822715586677704`*^9, 3.9822718388944664`*^9}, {
  3.9822718870490513`*^9, 3.9822719338764153`*^9}, {3.982271987796772*^9, 
