 CellChangeTimes->{{3.985898033519764*^9, 3.985898038612192*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"851f06ec-8100-2f49-9789-fa304256d9e5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"S", "[", 
   RowBox[{"u_", ",", "v_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"v", "+", "2"}], ")"}], "*", 
     RowBox[{"Cos", "[", "u", "]"}]}], ",", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"v", "+", "2"}], ")"}], "*", 
     RowBox[{"Sin", "[", "u", "]"}]}], ",", 
    RowBox[{"0.3", "*", 
     RowBox[{"(", 
      RowBox[{"u", "-", "v"}], ")"}]}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.985898084169695*^9, 3.9858981466201515`*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"bcd96b8d-1c70-dd44-a529-81d5b558574c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"objpara", "=", 
  RowBox[{"ParametricPlot3D", "[", 
   RowBox[{
    RowBox[{"S", "[", 
     RowBox[{"u", ",", "v"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"u", ",", "0", ",", 
      RowBox[{"4", "*", "Pi"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"v", ",", "0", ",", "6"}], "}"}], ",", 
    RowBox[{"Mesh", "->", "True"}], ",", 
    RowBox[{"MeshStyle", "->", "Blue"}], ",", 
    RowBox[{"PlotPoints", "->", "30"}], ",", 
    RowBox[{"PlotStyle", "->", 
     RowBox[{"{", 
      RowBox[{"Orange", ",", 
       RowBox[{"Specularity", "[", "5", "]"}], ",", 
       RowBox[{"Opacity", "[", "0.5", "]"}]}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.985898153172943*^9, 3.9858981964730377`*^9}, {
