Cell[BoxData[
 RowBox[{
  RowBox[{"Rot5", "[", 
   RowBox[{"O1_", ",", "O2_", ",", "OTraj_", ",", "Traj_", ",", "trange_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "TAll", ",", "MTran1", ",", "MTran2", ",", "Trans1", ",", "Trans2", ",", 
      "t1", ",", "a1", ",", "GAll"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"MTran1", "[", 
       RowBox[{"t1_", ",", "a1_"}], "]"}], ":=", 
      RowBox[{"Composition", "[", 
       RowBox[{
        RowBox[{"TranslationTransform", "[", 
         RowBox[{"Traj", "[", 
          RowBox[{
           RowBox[{"-", "t1"}], "+", "trange"}], "]"}], "]"}], ",", 
        RowBox[{"RotationTransform", "[", "a1", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Trans1", "[", 
       RowBox[{"t1_", ",", "a1_"}], "]"}], ":=", 
      RowBox[{"GeometricTransformation", "[", 
       RowBox[{"O1", ",", 
        RowBox[{"MTran1", "[", 
         RowBox[{"t1", ",", "a1"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"MTran2", "[", 
       RowBox[{"t1_", ",", "a1_"}], "]"}], ":=", 
      RowBox[{"Composition", "[", 
       RowBox[{
        RowBox[{"TranslationTransform", "[", 
         RowBox[{"Traj", "[", 
          RowBox[{"t1", "-", "trange"}], "]"}], "]"}], ",", 
        RowBox[{"RotationTransform", "[", "a1", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Trans2", "[", 
       RowBox[{"t1_", ",", "a1_"}], "]"}], ":=", 
      RowBox[{"GeometricTransformation", "[", 
       RowBox[{"O2", ",", 
        RowBox[{"MTran2", "[", 
         RowBox[{"t1", ",", "a1"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GAll", "[", 
       RowBox[{"t1_", ",", "a1_"}], "]"}], ":=", 
      RowBox[{"Graphics", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Trans1", "[", 
           RowBox[{"t1", ",", "a1"}], "]"}], ",", 
          RowBox[{"Trans2", "[", 
           RowBox[{"t1", ",", "a1"}], "]"}], ",", "OTraj"}], "}"}], ",", 
        RowBox[{"Axes", "->", "True"}], ",", 
        RowBox[{"PlotRange", "->", "60"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "GAll"}]}], 
   "]"}]}]], "Input",
