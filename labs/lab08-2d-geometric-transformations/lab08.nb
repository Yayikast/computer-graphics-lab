Cell[BoxData[
 RowBox[{
  RowBox[{"Rot7", "[", 
   RowBox[{"O1_", ",", "O2_", ",", "OTraj_", ",", "Traj_", ",", "trange_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "TAll", ",", "MTran1", ",", "MTran2", ",", "Trans1", ",", "Trans2", ",", 
      "t1", ",", "a1", ",", "GAll"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"GAll", "[", 
       RowBox[{"t1_", ",", "a1_"}], "]"}], ":=", 
      RowBox[{"Graphics", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"GeometricTransformation", "[", 
           RowBox[{"O1", ",", 
            RowBox[{"Composition", "[", 
             RowBox[{
              RowBox[{"TranslationTransform", "[", 
               RowBox[{"Traj", "[", 
                RowBox[{
                 RowBox[{"-", "t1"}], "+", "trange"}], "]"}], "]"}], ",", 
              RowBox[{"RotationTransform", "[", "a1", "]"}]}], "]"}]}], "]"}],
           ",", 
          RowBox[{"GeometricTransformation", "[", 
           RowBox[{"O2", ",", 
            RowBox[{"Composition", "[", 
             RowBox[{
              RowBox[{"TranslationTransform", "[", 
               RowBox[{"Traj", "[", 
                RowBox[{"t1", "-", "trange"}], "]"}], "]"}], ",", 
              RowBox[{"RotationTransform", "[", "a1", "]"}]}], "]"}]}], "]"}],
           ",", "OTraj"}], "}"}], ",", 
        RowBox[{"Axes", "->", "True"}], ",", 
        RowBox[{"PlotRange", "->", "60"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "GAll"}]}], "]"}]}]], "Input",
