Cell[BoxData[
 RowBox[{
  RowBox[{"Rot2", "[", 
   RowBox[{"ONew_", ",", "OTNew_", ",", "Traj_", ",", "t_", ",", "a_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"MTran", ",", "t1", ",", "a1", ",", "Trans", ",", "G1"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"MTran", "[", 
       RowBox[{"t1_", ",", "a1_"}], "]"}], ":=", 
      RowBox[{"Composition", "[", 
       RowBox[{
        RowBox[{"TranslationTransform", "[", 
         RowBox[{"Traj", "[", "t1", "]"}], "]"}], ",", 
        RowBox[{"RotationTransform", "[", "a1", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Trans", "[", 
       RowBox[{"t1_", ",", "a1_"}], "]"}], ":=", 
      RowBox[{"GeometricTransformation", "[", 
       RowBox[{"ONew", ",", 
        RowBox[{"MTran", "[", 
         RowBox[{"t1", ",", "a1"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"G1", "[", 
       RowBox[{"t1_", ",", "a1_"}], "]"}], ":=", 
      RowBox[{"Graphics", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Trans", "[", 
           RowBox[{"t1", ",", "a1"}], "]"}], ",", "OTNew"}], "}"}], ",", 
        RowBox[{"Axes", "->", "True"}], ",", 
        RowBox[{"PlotRange", "->", "60"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "G1"}]}], "]"}]}]], "Input",
