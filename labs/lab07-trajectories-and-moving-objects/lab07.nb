Cell[BoxData[
 RowBox[{
  RowBox[{"Interp3D", "[", "data_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "z", ",", "fx", ",", "fy", ",", "fz"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"x", "=", 
      RowBox[{
       RowBox[{"Transpose", "[", "data", "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"y", "=", 
      RowBox[{
       RowBox[{"Transpose", "[", "data", "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"z", "=", 
      RowBox[{
       RowBox[{"Transpose", "[", "data", "]"}], "[", 
       RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"fx", "=", 
      RowBox[{"Interpolation", "[", "x", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"fy", "=", 
      RowBox[{"Interpolation", "[", "y", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"fz", "=", 
      RowBox[{"Interpolation", "[", "z", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"traj", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"fx", "[", "#1", "]"}], ",", 
         RowBox[{"fy", "[", "#1", "]"}], ",", 
         RowBox[{"fz", "[", "#1", "]"}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", "traj"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[160]:=",ExpressionUUID->"4fcf6a41-7ea2-1c4e-a11f-e2a531362b69"],

