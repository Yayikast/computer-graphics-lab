Cell[BoxData[{
 RowBox[{
  RowBox[{"f1", "[", "t_", "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"R1", "*", 
     RowBox[{"Cos", "[", "t", "]"}]}], ",", 
    RowBox[{
     RowBox[{"R1", "*", 
      RowBox[{"Sin", "[", "t", "]"}]}], "+", "R1"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f2", "[", "t_", "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{"t", ",", "R1"}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Tr1", "[", "t_", "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"t", ">=", "0"}], " ", "&&", " ", 
     RowBox[{"t", "<=", 
      RowBox[{"2", "*", "Pi"}]}]}], ",", 
    RowBox[{"f1", "[", "t", "]"}], ",", 
    RowBox[{"f2", "[", "t", "]"}]}], "]"}]}]}], "Input",
