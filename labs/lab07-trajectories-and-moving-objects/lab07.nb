Cell[BoxData[
 RowBox[{
  RowBox[{"Aver1", "[", "L_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"S1", ",", "i", ",", "T"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"T", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"L", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "!=", "0"}], ",", 
          RowBox[{"1", "/", 
           RowBox[{"L", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ",", "Nothing"}], "]"}], ",", 
