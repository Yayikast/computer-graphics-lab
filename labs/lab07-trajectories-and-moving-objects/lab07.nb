Cell[BoxData[
 RowBox[{
  RowBox[{"MoveF3", "[", 
   RowBox[{
   "F_", ",", "traj_", ",", "L0_", ",", "ColorS_", ",", "ColorT_", ",", 
    "rr_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "t1", ",", "plottraj", ",", "plotpoints", ",", "plotF1", ",", "plotF"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"plottraj", "=", 
      RowBox[{"ParametricPlot3D", "[", 
       RowBox[{
        RowBox[{"traj", "[", "t1", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"t1", ",", "1", ",", "L0"}], "}"}], ",", 
        RowBox[{"PlotStyle", "->", "ColorT"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"plotF", "[", "t1_", "]"}], ":=", 
      RowBox[{"Graphics3D", "[", 
       RowBox[{"{", 
        RowBox[{"ColorS", ",", 
         RowBox[{"F", "[", 
          RowBox[{
           RowBox[{"traj", "[", "t1", "]"}], ",", "rr"}], "]"}]}], "}"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"plotF1", "[", "t1_", "]"}], ":=", 
      RowBox[{"Show", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"plotF", "[", "t1", "]"}], ",", "plottraj"}], "}"}], ",", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"L0", "+", "1"}]}], "}"}]}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "plotF1"}]}], "]"}]}]], "Input",
