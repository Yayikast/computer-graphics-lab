Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"tor", "=", 
   RowBox[{"Torus", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "8"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Graphics3D", "[", 
   RowBox[{"{", 
    RowBox[{"Red", ",", "tor"}], "}"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Graphics3D", "[", "tor", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sph1", "=", 
   RowBox[{"{", 
    RowBox[{"Blue", ",", 
     RowBox[{"Sphere", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "1.3"}], "]"}]}], 
    "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Graphics3D", "[", "sph1", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cen", "=", 
   RowBox[{"{", 
    RowBox[{"Green", ",", 
     RowBox[{"Icosahedron", "[", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}], "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Graphics3D", "[", 
   RowBox[{"{", 
    RowBox[{"Green", ",", "cen"}], "}"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rot1", "[", "a_", "]"}], ":=", 
  RowBox[{"GeometricTransformation", "[", 
   RowBox[{"sph1", ",", 
    RowBox[{"Composition", "[", 
     RowBox[{
      RowBox[{"RotationTransform", "[", 
       RowBox[{"a", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "]"}], ",", 
      RowBox[{"TranslationTransform", "[", 
       RowBox[{"{", 
        RowBox[{"8", ",", "0", ",", "0"}], "}"}], "]"}]}], "]"}]}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"rot2", "[", 
   RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], ":=", 
  RowBox[{"GeometricTransformation", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"c", ",", 
        RowBox[{"Opacity", "[", "0.8", "]"}], ",", "tor"}], "}"}], ",", 
      RowBox[{"rot1", "[", "a", "]"}]}], "}"}], ",", 
    RowBox[{"RotationTransform", "[", 
     RowBox[{"b", ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Graphics3D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rot2", "[", 
        RowBox[{"a", ",", "b", ",", "c"}], "]"}], ",", "cen"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "12"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", "0", ",", 
     RowBox[{"2", "*", "Pi"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"b", ",", "0", ",", 
     RowBox[{"2", "*", "Pi"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"c", ",", 
     RowBox[{"RandomColor", "[", "10", "]"}]}], "}"}]}], "]"}]}], "Input",
