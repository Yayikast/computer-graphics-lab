Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"S", "[", 
    RowBox[{"u_", ",", "v_"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"v", "+", "2"}], ")"}], "*", 
      RowBox[{"Cos", "[", "u", "]"}]}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"v", "+", "2"}], ")"}], "*", 
      RowBox[{"Sin", "[", "u", "]"}]}], ",", 
     RowBox[{"0.3", "*", 
      RowBox[{"(", 
       RowBox[{"u", "-", "v"}], ")"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"objpara", "=", 
   RowBox[{"ParametricPlot3D", "[", 
    RowBox[{
     RowBox[{"S", "[", 
      RowBox[{"u", ",", "v"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"u", ",", "0", ",", 
       RowBox[{"4", "*", "Pi"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"v", ",", "0", ",", "6"}], "}"}], ",", 
     RowBox[{"Mesh", "->", "True"}], ",", 
     RowBox[{"MeshStyle", "->", "Blue"}], ",", 
     RowBox[{"PlotPoints", "->", "30"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Orange", ",", 
        RowBox[{"Specularity", "[", "5", "]"}], ",", 
        RowBox[{"Opacity", "[", "0.5", "]"}]}], "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"objgraphics", "=", 
   RowBox[{"objpara", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"anc", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"objrotate", "[", 
    RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
   RowBox[{"GeometricTransformation", "[", 
    RowBox[{"objgraphics", ",", 
     RowBox[{"Composition", "[", 
      RowBox[{
       RowBox[{"TranslationTransform", "[", "anc", "]"}], ",", 
       RowBox[{"RotationTransform", "[", 
        RowBox[{"a", ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "]"}], ",", 
       RowBox[{"RotationTransform", "[", 
        RowBox[{"b", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "]"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"colors", "=", 
   RowBox[{"RandomColor", "[", "12", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Graphics3D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"objrotate", "[", 
        RowBox[{"a", ",", "b"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"c", ",", 
         RowBox[{"Sphere", "[", 
          RowBox[{"anc", ",", "1"}], "]"}]}], "}"}]}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "10"}], ",", 
     RowBox[{"Axes", "->", "True"}], ",", 
     RowBox[{"AxesOrigin", "->", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", "0", ",", 
     RowBox[{"2", "*", "Pi"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"b", ",", "0", ",", 
     RowBox[{"2", "*", "Pi"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"c", ",", "colors"}], "}"}]}], "]"}]}], "Input",
