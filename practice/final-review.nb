Cell[BoxData[
 RowBox[{
  RowBox[{"Interp3D", "[", "data_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "z", ",", "fx", ",", "fy", ",", "fz"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"x", "=", 
      RowBox[{
       RowBox[{"Transpose", "[", "data", "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"y", "=", 
      RowBox[{
       RowBox[{"Transpose", "[", "data", "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"z", "=", 
      RowBox[{
       RowBox[{"Transpose", "[", "data", "]"}], "[", 
       RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"fx", "=", 
      RowBox[{"Interpolation", "[", "x", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"fy", "=", 
      RowBox[{"Interpolation", "[", "y", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"fz", "=", 
      RowBox[{"Interpolation", "[", "z", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"traj", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"fx", "[", "#1", "]"}], ",", 
         RowBox[{"fy", "[", "#1", "]"}], ",", 
         RowBox[{"fz", "[", "#1", "]"}]}], "}"}], "&"}]}], ";", 
     "\[IndentingNewLine]", "traj"}]}], "]"}]}]], "Input",
 FontFamily->"Consolas",
 FontSize->12,
 CellLabel->"In[11]:=",ExpressionUUID->"6909b353-d58b-f64b-bd8f-c986105b7597"],

