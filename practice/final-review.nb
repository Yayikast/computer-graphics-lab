  RowBox[{"PrimePlot", "[", 
   RowBox[{"from_", ",", "to_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"i", ",", "plot", ",", "T"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"T", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"PrimeQ", "[", "i", "]"}], ",", "i", ",", "Nothing"}], 
         "]"}], ",", 
